#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td_shift: td_shift {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESCAPE  &kp Q            &kp W            &kp E         &kp R              &kp T                         &kp UP                &kp Y        &kp U               &kp I         &kp O             &kp P                &kp LEFT_BRACKET
&kp TAB     &hrm LEFT_WIN A  &hrm LEFT_ALT S  &hrm RCTRL D  &hrm LEFT_SHIFT F  &kp G               &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &hrm RIGHT_SHIFT J  &hrm RCTRL K  &hrm RIGHT_ALT L  &hrm RIGHT_WIN SEMI  &kp SQT
&kp GRAVE   &kp Z            &kp X            &kp C         &kp V              &kp B      &none              &kp DOWN              &kp N        &kp M               &kp COMMA     &kp DOT           &kp FSLH             &kp RIGHT_BRACKET
                                              &lt 2 INSERT  &mo 1              &kp SPACE                                           &lt 3 ENTER  &lt 1 BACKSPACE     &lt 2 DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "SYM_NM";
            bindings = <
&trans  &kp EXCL          &kp AT            &kp HASH       &kp DOLLAR          &kp PERCENT                             &mmv MOVE_UP                     &kp CARET         &kp AMPS             &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER
&trans  &hrm LEFT_WIN N1  &hrm LEFT_ALT N2  &hrm LCTRL N3  &hrm LEFT_SHIFT N4  &kp N5                  &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp N6            &hrm RIGHT_SHIFT N7  &hrm RCTRL N8  &hrm RIGHT_ALT N9     &hrm RIGHT_WIN N0      &kp MINUS
&trans  &kp CAPS          &kp SLASH         &kp QUESTION   &kp PIPE            &kp BACKSLASH  &none                    &mmv MOVE_DOWN                   &kp LEFT_BRACKET  &kp RIGHT_BRACKET    &kp COMMA      &kp DOT               &kp EQUAL              &kp PLUS
                                            &trans         &trans              &kp SPACE                                                                &kp ENTER         &kp BACKSPACE        &kp DEL
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "FN_NAVY";
            bindings = <
&kp F1  &kp F2         &kp F3        &kp F4            &kp F5           &kp F6                                   &mmv MOVE_UP                     &kp F7          &hrm RIGHT_SHIFT F8  &hrm RIGHT_CONTROL F9  &hrm RIGHT_ALT F10  &kp F11       &kp F12
&trans  &kp RIGHT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT   &msc SCRL_UP             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT_ARROW  &kp DOWN_ARROW       &kp UP_ARROW           &kp RIGHT_ARROW     &kp LEFT_GUI  &kp PRINTSCREEN
&trans  &kp INSERT     &none         &none             &kp PAUSE_BREAK  &msc SCRL_DOWN  &none                    &mmv MOVE_DOWN                   &kp HOME        &kp PAGE_DOWN        &kp PAGE_UP            &kp END             &kp INSERT    &kp K_CONTEXT_MENU
                                     &trans            &trans           &kp SPACE                                                                 &kp ENTER       &kp BACKSPACE        &kp DELETE
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "SUS_MS";
            bindings = <
&kp ESC         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                             &mmv MOVE_UP                     &kp C_PREV      &kp C_PLAY_PAUSE  &kp C_NEXT    &kp C_VOL_DN     &kp C_VOLUME_UP  &kp C_MUTE
&bt BT_CLR      &none         &mkp LCLK     &mkp MCLK     &mkp RCLK     &msc SCRL_UP             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &mmv MOVE_LEFT  &mmv MOVE_DOWN    &mmv MOVE_UP  &mmv MOVE_RIGHT  &none            &none
&bt BT_CLR_ALL  &none         &bl BL_TOG    &bl BL_CYCLE  &none         &msc SCRL_DOWN  &none                    &mmv MOVE_DOWN                   &msc SCRL_LEFT  &msc SCRL_DOWN    &msc SCRL_UP  &msc SCRL_RIGHT  &kp SCROLLLOCK   &trans
                                            &trans        &trans        &trans                                                                    &trans          &trans            &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
